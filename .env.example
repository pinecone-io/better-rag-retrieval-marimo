# Copy this file to .env and paste your keys. See the README's
# "Get your API keys" section for step-by-step links.

# Pinecone — the vector + full-text indexes. https://app.pinecone.io  (free Starter plan is fine)
PINECONE_API_KEY=

# Google Gemini — embeddings for text and images. https://aistudio.google.com  (free tier covers this demo)
GOOGLE_API_KEY=

# Anthropic Claude — the agentic router + RAG answers. https://console.anthropic.com  (needs a small prepaid balance)
ANTHROPIC_API_KEY=
